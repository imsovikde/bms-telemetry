# EditorConfig helps developers define and maintain consistent coding styles
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json}]
indent_size = 2

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf
indent_size = 2
